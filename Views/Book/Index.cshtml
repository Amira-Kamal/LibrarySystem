@model IEnumerable<Book>

@{
    ViewData["Title"] = "Books";
}

<div class="books-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>Books</h2>
        <p class="text-muted mb-0">Explore our collection of amazing books</p>
    </div>

    
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-primary">
            + Add Book
        </a>
    }
   

</div>

<div class="books-grid">
    @foreach (var item in Model)
    {
        <div class="book-card">

            
            <div class="book-image-wrapper">
                @if (!string.IsNullOrEmpty(item.Image))
                {
                    <img src="@item.Image"
                         alt="@item.Title"
                         class="book-image" />
                }
                else
                {
                    <div class="book-image-placeholder">
                        <span>📖</span>
                    </div>
                }

                <div class="book-overlay">
                    <a asp-action="Details"
                       asp-route-id="@item.BookId"
                       class="btn-view">
                        View Details
                    </a>
                </div>
            </div>

            <div class="book-info">

                <h5 class="book-title" title="@item.Title">
                    @item.Title
                </h5>

                <div class="book-copies">
                    <span class="copies-count">
                        @item.AvailableCopies
                    </span>
                    <span class="copies-total">
                        / @item.TotalCopies
                    </span>
                </div>

                <div class="book-status">
                    @if (item.AvailableCopies > 0)
                    {
                        <span class="badge-available">
                            🟢 Available
                        </span>
                    }
                    else
                    {
                        <span class="badge-unavailable">
                            🔴 Out of Stock
                        </span>
                    }
                </div>

                @if (item.Category != null)
                {
                    <div class="book-category">
                        <span class="category-tag">
                            @item.Category.Name
                        </span>
                    </div>
                }

                @if (item.Author != null)
                {
                    <div class="book-author">
                        <small>
                            by @item.Author.FirstName @item.Author.LastName
                        </small>
                    </div>
                }

                <div class="book-actions mt-3">

                    @if (User.IsInRole("Admin"))
                    {
                        <div class="d-flex gap-2">
                            <a asp-action="Edit"
                               asp-route-id="@item.BookId"
                               class="btn btn-sm btn-warning flex-fill">
                                Edit
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@item.BookId"
                               class="btn btn-sm btn-danger flex-fill">
                                Delete
                            </a>
                        </div>
                    }
                    else if (item.AvailableCopies > 0 &&
                    User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-controller="Borrowing"
                           asp-action="Create"
                           asp-route-bookId="@item.BookId"
                           class="btn btn-sm btn-success w-100">
                            Borrow Now
                        </a>
                    }
                    else if (item.AvailableCopies <= 0)
                    {
                        <button class="btn btn-sm btn-secondary w-100" disabled>
                            Not Available
                        </button>
                    }
                    else
                    {
                        <a asp-controller="Account"
                           asp-action="Login"
                           class="btn btn-sm btn-outline-primary w-100">
                            Login to Borrow
                        </a>
                    }

                </div>

            </div>
        </div>
    }
    

</div>
