@model LibrarySystem.Models.Borrowing

@{
    ViewData["Title"] = "Borrow Book";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">

           
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">

                    <h2 class="mb-3">Borrow Book</h2>

                    <p class="text-muted">
                        Select the book you want to borrow.
                    </p>

                    <hr />

                    <form asp-action="Create" method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="All"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">
                            <label asp-for="BookId" class="form-label">
                                Book
                            </label>

                            <select asp-for="BookId"
                                    class="form-select"
                                    asp-items="ViewBag.BookId">
                                <option value="">-- Select a Book --</option>
                            </select>

                            <span asp-validation-for="BookId"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="d-flex gap-2 mt-4">

                            <button type="submit"
                                    class="btn btn-success">
                               Borrow Book
                            </button>

                            <a asp-controller="Book"
                               asp-action="Index"
                               class="btn btn-secondary">
                                Back to Books
                            </a>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
    

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}


