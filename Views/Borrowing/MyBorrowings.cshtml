@model IEnumerable<LibrarySystem.Models.Borrowing>

@{
    ViewData["Title"] = "My Borrowings";
}

<div class="container py-4">

    
    <div class="text-center mb-4">
        <h2>My Borrowings</h2>
        <p class="text-muted">
            Books you currently have borrowed
        </p>
    </div>

    @if (Model.Any())
    {
        <div class="row g-4">

            @foreach (var item in Model)
            {
                <div class="col-md-4">

                    <div class="card h-100 shadow-sm">

                        @if (!string.IsNullOrEmpty(item.Book?.Image))
                        {
                            <img src="@item.Book.Image"
                                 class="card-img-top"
                                 alt="@item.Book.Title"
                                 style="height: 250px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="d-flex align-items-center justify-content-center bg-light"
                                 style="height: 250px;">
                                <span style="font-size: 60px;">📖</span>
                            </div>
                        }

                        <div class="card-body">

                            <h5 class="card-title">
                                @item.Book?.Title
                            </h5>

                            <p class="text-muted mb-2">
                                Borrowed on:
                                @item.BorrowDate.ToString("dd/MM/yyyy")
                            </p>

                            <span class="badge bg-success mb-3">
                                Borrowed
                            </span>

                            <div>
                                <a asp-controller="Book"
                                   asp-action="Details"
                                   asp-route-id="@item.BookId"
                                   class="btn btn-primary btn-sm">
                                    View Book
                                </a>

                                <form asp-action="Return"
                                      asp-route-id="@item.Id"
                                      method="post"
                                      class="d-inline">

                                    <button type="submit"
                                            class="btn btn-warning btn-sm">
                                        Return Book
                                    </button>

                                </form>
                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="text-center py-5">

            <div style="font-size: 60px;">📚</div>

            <h4 class="mt-3">
                You haven't borrowed any books yet.
            </h4>

            <p class="text-muted">
                Explore our library and borrow a book you like.
            </p>

            <a asp-controller="Book"
               asp-action="Index"
               class="btn btn-primary">
                Explore Books
            </a>

        </div>
    }
    

</div>

