@model LibrarySystem.Models.Category

@{
    ViewData["Title"] = "Category Details";
}

<div class="row justify-content-center">
    <div class="col-md-7">

        
        <div class="card shadow-sm">
            <div class="card-body p-4">

                <h2 class="mb-3">Category Details</h2>

                <hr />

                <dl class="row">

                    <dt class="col-sm-4">
                        Category Name
                    </dt>

                    <dd class="col-sm-8">
                        @Model.Name
                    </dd>

                </dl>

                <div class="mt-4">

                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Edit"
                           asp-route-id="@Model.CategoryId"
                           class="btn btn-warning">
                            Edit
                        </a>
                    }

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Back to Categories
                    </a>

                </div>

            </div>
        </div>

    </div>
    

</div>

